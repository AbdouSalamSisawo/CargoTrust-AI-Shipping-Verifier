# Copy to .env.local (npm) or .env (docker compose) and fill in what you need.
# Every variable is optional.

# AI reading for scanned PDFs and phone photos (https://console.anthropic.com).
# Can also be entered by an administrator under Settings → AI reading.
ANTHROPIC_API_KEY=
# Vision model used for AI reading (default: claude-haiku-5-5; claude-opus-5-5 for the most accurate reads).
CARGOTRUST_AI_MODEL=

# First administrator account, created on first boot only.
# Without ADMIN_PASSWORD a random password is generated and written to data/admin-credentials.txt.
ADMIN_EMAIL=admin@cargotrust.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Key that signs session cookies (32+ random characters). When empty, one is generated and kept in
# data/.auth-secret (file storage) or in the database (Postgres).
AUTH_SECRET=

# Storage. Leave both empty to keep everything in data/ on this server (laptop, single Docker container).
# Postgres for the database (Neon on Vercel, or any Postgres 13+). DATABASE_URL_POOLED is used first when set.
DATABASE_URL=
# Private Vercel Blob store for uploaded documents and cached reads. On Vercel, connecting a Blob store
# to the project sets this (or BLOB_STORE_ID) automatically.
BLOB_READ_WRITE_TOKEN=

# 0 = start with an empty inbox instead of the 520-email sample set.
SAMPLE_DATA=1
